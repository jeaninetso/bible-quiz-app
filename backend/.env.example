# Copy to .env and fill in.

# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Omit entirely for local dev — falls back to a SQLite file (backend/dev.db).
DATABASE_URL=postgresql+psycopg://scripture:scripture@localhost:5432/scripture_quest

# Signs the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=changeme

# ESV API — free key from https://api.esv.org/account/create-application/
ESV_API_KEY=

# Anthropic API — key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Only needed once this is deployed somewhere other than localhost ---

# The exact origin the frontend is served from (browsers reject credentialed
# CORS against a wildcard, so this must be an exact match, not "*").
CORS_ORIGIN=http://localhost:5173

# Browsers reject Secure cookies over plain http — set true once served over
# https (i.e. any real deployment; leave false for local dev).
COOKIE_SECURE=false

# "lax" works whenever frontend and API are same-origin or same-site (e.g.
# local dev: same host, different ports). Only set to "none" (requires
# COOKIE_SECURE=true) if frontend and API truly can't share an origin — even
# then, real browsers increasingly block third-party cookies regardless of
# SameSite, so prefer reverse-proxying API calls through the frontend's own
# origin instead (see render.yaml) rather than relying on SameSite=None.
COOKIE_SAMESITE=lax

# slowapi rate-limit strings ("N/second|minute|hour|day"). Quiz generation
# spends Anthropic credits per call; login is the brute-forceable endpoint.
# Defaults assume a small, mostly-trusted user base — tighten for a public
# deployment.
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_QUIZ=20/hour

# One-line swap if quiz quality needs a stronger model later.
QUIZ_MODEL=claude-haiku-4-5
